<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ app_name | capitalize }} — {{ env | upper }}</title>
  <style>
    body { font-family: sans-serif; display: flex; align-items: center; justify-content: center;
           min-height: 100vh; margin: 0; background: #f0f4f8; }
    .card { background: #fff; border-radius: 8px; padding: 2rem 3rem; box-shadow: 0 2px 8px rgba(0,0,0,.12);
            text-align: center; max-width: 480px; }
    h1   { color: #1a73e8; margin-bottom: .5rem; }
    .env { display: inline-block; padding: .2rem .8rem; border-radius: 12px; font-size: .85rem;
           font-weight: 600; margin-bottom: 1rem;
           background: {% if env == 'production' %}#d32f2f{% elif env == 'staging' %}#f57c00{% else %}#388e3c{% endif %};
           color: #fff; }
    p    { color: #555; line-height: 1.6; }
    code { background: #f1f1f1; padding: .1rem .4rem; border-radius: 4px; font-size: .9rem; }
  </style>
</head>
<body>
  <div class="card">
    <h1>{{ app_name | capitalize }}</h1>
    <span class="env">{{ env | upper }}</span>
    <p>Served by <code>{{ ansible_hostname }}</code></p>
    <p>Version <code>{{ app_version }}</code> · {{ ansible_date_time.date }}</p>
  </div>
</body>
</html>
